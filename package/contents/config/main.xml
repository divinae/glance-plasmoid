<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
      http://www.kde.org/standards/kcfg/1.0/kcfg.xsd" >
  <kcfgfile name=""/>

  <group name="General">
    <!-- Compact text: 0 application name, 1 window title, 2 application — title -->
    <entry name="compactStyle" type="Enum">
      <choices>
        <choice name="Application"/>
        <choice name="Title"/>
        <choice name="ApplicationTitle"/>
      </choices>
      <default>0</default>
    </entry>
    <entry name="placeholder" type="String">
      <default>Plasma Desktop</default>
    </entry>
    <entry name="maxTitleLength" type="Int">
      <default>40</default>
      <min>4</min>
      <max>200</max>
    </entry>
    <entry name="showAppIcon" type="Bool">
      <default>false</default>
    </entry>
    <!-- Status segments in the panel's capsule -->
    <entry name="pillCamera" type="Bool">
      <default>true</default>
    </entry>
    <entry name="pillMicrophone" type="Bool">
      <default>true</default>
    </entry>
    <entry name="pillScreen" type="Bool">
      <default>true</default>
    </entry>
    <entry name="pillFocus" type="Bool">
      <default>true</default>
    </entry>
    <!-- File transfers (copies, downloads): a pill with their progress -->
    <entry name="pillJobs" type="Bool">
      <default>true</default>
    </entry>
    <entry name="pillMeeting" type="Bool">
      <default>true</default>
    </entry>
    <entry name="pillDnd" type="Bool">
      <default>true</default>
    </entry>
    <entry name="showCapsule" type="Bool">
      <default>false</default>
    </entry>
    <entry name="boldFont" type="Bool">
      <default>false</default>
    </entry>
    <entry name="capitalFont" type="Bool">
      <default>false</default>
    </entry>
    <entry name="lengthMargin" type="Int">
      <default>16</default>
      <min>0</min>
      <max>64</max>
    </entry>
    <entry name="filterByScreen" type="Bool">
      <default>true</default>
    </entry>

    <entry name="openOnHover" type="Bool">
      <default>true</default>
    </entry>
    <entry name="hoverDelay" type="Int">
      <default>400</default>
      <min>0</min>
      <max>2000</max>
    </entry>
    <entry name="closeDelay" type="Int">
      <default>250</default>
      <min>0</min>
      <max>2000</max>
    </entry>
    <entry name="popupHeight" type="Int">
      <default>24</default>
      <min>10</min>
      <max>40</max>
    </entry>
    <!-- 0 drawer out of the screen edge (layer-shell), 1 Plasma's popup -->
    <entry name="popupStyle" type="Enum">
      <choices>
        <choice name="Drawer"/>
        <choice name="Popup"/>
      </choices>
      <default>0</default>
    </entry>
    <!-- 0 out of the panel's edge beside the island, 1 centered under the top of the screen -->
    <entry name="drawerEdge" type="Enum">
      <choices>
        <choice name="Panel"/>
        <choice name="Top"/>
      </choices>
      <default>0</default>
    </entry>
    <entry name="drawerRadius" type="Int">
      <default>20</default>
      <min>0</min>
      <max>48</max>
    </entry>
    <entry name="drawerWidth" type="Int">
      <default>38</default>
      <min>20</min>
      <max>50</max>
    </entry>
    <entry name="drawerBlur" type="Bool">
      <default>true</default>
    </entry>
    <!-- Opacity of the drawer's surface over the blur, percent -->
    <entry name="drawerOpacity" type="Int">
      <default>70</default>
      <min>20</min>
      <max>100</max>
    </entry>
    <entry name="switchTabOnHover" type="Bool">
      <default>true</default>
    </entry>

    <entry name="showAppMenu" type="Bool">
      <default>true</default>
    </entry>
    <entry name="showWindowButtons" type="Bool">
      <default>true</default>
    </entry>
    <entry name="showMedia" type="Bool">
      <default>true</default>
    </entry>
    <entry name="mediaInPanel" type="Bool">
      <default>true</default>
    </entry>
    <entry name="cavaInPanel" type="Bool">
      <default>true</default>
    </entry>
    <!-- Panel audio bars: 0 behind the text, 1 beside the text, 2 a small equalizer in place of
         the icon, 3 a thin strip along the panel's outer edge -->
    <entry name="cavaStyle" type="Enum">
      <choices>
        <choice name="Background"/>
        <choice name="Beside"/>
        <choice name="Mini"/>
        <choice name="Edge"/>
      </choices>
      <default>2</default>
    </entry>
    <!-- Edge style: 0 the panel's outer edge (the screen's), 1 its inner edge (the windows') -->
    <entry name="cavaEdge" type="Enum">
      <choices>
        <choice name="Outer"/>
        <choice name="Inner"/>
      </choices>
      <default>0</default>
    </entry>
    <!-- Opacity of the panel's bars in the Beside, Mini and Edge styles, percent -->
    <entry name="cavaPanelOpacity" type="Int">
      <default>100</default>
      <min>10</min>
      <max>100</max>
    </entry>
    <entry name="cavaBackgroundOpacity" type="Int">
      <default>50</default>
      <min>5</min>
      <max>100</max>
    </entry>
    <entry name="cavaBars" type="Int">
      <default>24</default>
      <min>2</min>
      <max>64</max>
    </entry>
    <entry name="cavaFramerate" type="Int">
      <default>30</default>
      <min>5</min>
      <max>144</max>
    </entry>
    <entry name="showProgressInPanel" type="Bool">
      <default>false</default>
    </entry>
    <entry name="showNotifications" type="Bool">
      <default>true</default>
    </entry>
    <!-- Unread notifications as a pill (was a dot; the key kept) -->
    <entry name="unreadDot" type="Bool">
      <default>true</default>
    </entry>
    <entry name="pulseEnabled" type="Bool">
      <default>true</default>
    </entry>
    <entry name="pulseOnJobs" type="Bool">
      <default>true</default>
    </entry>
    <entry name="pulseShowSummary" type="Bool">
      <default>false</default>
    </entry>
    <entry name="pulseIgnoreApps" type="StringList">
      <default></default>
    </entry>
    <entry name="calendarEnabled" type="Bool">
      <default>true</default>
    </entry>
    <!-- No screen-off, lock or sleep while a meeting is on -->
    <entry name="keepAwakeMeetings" type="Bool">
      <default>true</default>
    </entry>
    <!-- A meeting coming up takes the panel text, ahead of the window and of media; one on now is the pill -->
    <entry name="meetingInStrip" type="Bool">
      <default>true</default>
    </entry>
    <entry name="calendarLeadMinutes" type="Int">
      <default>15</default>
      <min>1</min>
      <max>240</max>
    </entry>
    <entry name="showSystem" type="Bool">
      <default>true</default>
    </entry>
    <entry name="showShelf" type="Bool">
      <default>true</default>
    </entry>
    <entry name="shelfItems" type="StringList">
      <default></default>
    </entry>
    <entry name="cavaMonstercat" type="Bool">
      <default>true</default>
    </entry>
    <entry name="cavaNoiseReduction" type="Int">
      <default>77</default>
      <min>0</min>
      <max>100</max>
    </entry>
    <!-- 0 bars, 1 wave -->
    <entry name="cavaPanelStyle" type="Int">
      <default>0</default>
      <min>0</min>
      <max>1</max>
    </entry>
    <entry name="cavaPopupStyle" type="Int">
      <default>0</default>
      <min>0</min>
      <max>1</max>
    </entry>
    <entry name="cavaRounded" type="Bool">
      <default>true</default>
    </entry>
    <entry name="pauseOnFullscreen" type="Bool">
      <default>true</default>
    </entry>
    <!-- Stand (from Shift): the sit/stand cycle, reminders and the desk; stand_ + Shift's keys -->
    <entry name="standEnabled" type="Bool">
      <default>false</default>
    </entry>

        <entry name="stand_sit_minutes" type="Int">
            <min>1</min>
            <max>600</max>
            <default>45</default>
        </entry>

        <entry name="stand_stand_minutes" type="Int">
            <min>1</min>
            <max>600</max>
            <default>15</default>
        </entry>

        <entry name="stand_daily_goal_minutes" type="Int">
            <!-- 0 turns the goal and the streak off. -->
            <min>0</min>
            <max>1440</max>
            <default>120</default>
        </entry>

        <entry name="stand_snooze_minutes" type="Int">
            <min>1</min>
            <max>120</max>
            <default>10</default>
        </entry>


        <entry name="stand_notification_enabled" type="Bool">
            <default>true</default>
        </entry>

        <entry name="stand_sfx_enabled" type="Bool">
            <default>true</default>
        </entry>

        <entry name="stand_sfx_filepath" type="String">
            <default>/usr/share/sounds/ocean/stereo/dialog-information.oga</default>
        </entry>

        <entry name="stand_sound_volume" type="Int">
            <min>0</min>
            <max>100</max>
            <default>80</default>
        </entry>

        <entry name="stand_desk_enabled" type="Bool">
            <default>false</default>
        </entry>

        <entry name="stand_desk_sit_cmd" type="String">
            <default>idasen sit</default>
        </entry>

        <entry name="stand_desk_stand_cmd" type="String">
            <default>idasen stand</default>
        </entry>

        <entry name="stand_desk_height_cmd" type="String">
            <default>idasen height</default>
        </entry>

        <entry name="stand_desk_save_cmd" type="String">
            <default>idasen save {position}</default>
        </entry>

        <entry name="stand_sit_height_cm" type="Double">
            <min>40</min>
            <max>160</max>
            <default>72</default>
        </entry>

        <entry name="stand_stand_height_cm" type="Double">
            <min>40</min>
            <max>160</max>
            <default>110</default>
        </entry>

        <entry name="stand_desk_poll_seconds" type="Int">
            <!-- Each read is a Bluetooth connection, so not too often. A minute is soon
                 enough to notice the desk's own buttons for the stats. -->
            <min>10</min>
            <max>3600</max>
            <default>60</default>
        </entry>

        <entry name="stand_auto_move_enabled" type="Bool">
            <default>false</default>
        </entry>


        <!-- No reminders or desk moves during a meeting (Event Calendar); a switch due soon at its end -->
        <entry name="stand_meeting_hold" type="Bool">
            <default>true</default>
        </entry>
        <!-- The desk rises for a meeting and goes back down after -->
        <entry name="stand_stand_for_meetings" type="Bool">
            <default>false</default>
        </entry>

        <!-- Posture switches wait for focus breaks, and one due soon is made at the break -->
        <entry name="stand_focus_sync_enabled" type="Bool">
            <default>true</default>
        </entry>

        <entry name="stand_away_on_lock_enabled" type="Bool">
            <default>true</default>
        </entry>

        <entry name="stand_work_hours_enabled" type="Bool">
            <default>false</default>
        </entry>

        <entry name="stand_work_start_minutes" type="Int">
            <min>0</min>
            <max>1439</max>
            <default>540</default>
        </entry>

        <entry name="stand_work_end_minutes" type="Int">
            <min>0</min>
            <max>1439</max>
            <default>1020</default>
        </entry>

        <entry name="stand_work_weekdays_only" type="Bool">
            <default>true</default>
        </entry>

        <entry name="stand_cycle_state" type="String">
            <default></default>
        </entry>

        <entry name="stand_stand_history" type="String">
            <default>{}</default>
        </entry>
    <!-- Focus (from Fokus): pomodoro/flowmodoro, tasks, history, break overlay; focus_ + Fokus's keys -->
    <entry name="focusEnabled" type="Bool">
      <default>false</default>
    </entry>

        <entry name="focus_focus_time" type="Int">
            <min>1</min>
            <max>9999</max>
            <default>25</default>
        </entry>

        <entry name="focus_short_break_time" type="Int">
            <min>0</min>
            <max>9999</max>
            <default>5</default>
        </entry>

        <entry name="focus_long_break_time" type="Int">
            <min>0</min>
            <max>9999</max>
            <default>20</default>
        </entry>

        <entry name="focus_ticking_time" type="Int">
            <min>0</min>
            <max>60</max>
            <default>10</default>
        </entry>

        <entry name="focus_number_of_sessions" type="Int">
            <min>1</min>
            <max>10</max>
            <default>4</default>
        </entry>

        <entry name="focus_flow_divisor" type="Int">
            <min>1</min>
            <max>9999</max>
            <!-- A fifth of the flow, which is the ratio flowmodoro is usually described
                 with. At 3 a two hour flow earned a 40 minute break. -->
            <default>5</default>
        </entry>

        <entry name="focus_flow_reminder_enabled" type="Bool">
            <default>false</default>
        </entry>

        <entry name="focus_flow_reminder_minutes" type="Int">
            <min>1</min>
            <max>9999</max>
            <default>30</default>
        </entry>


        <entry name="focus_clock_fontfamily" type="String">
            <default></default>
        </entry>

        <entry name="focus_clock_bold" type="Bool">
            <!-- Applies wherever clock_fontfamily does: the panel countdown and the dial.
                 A 44px vertical panel fits the digits at about 16px, where weight buys
                 more legibility than size can. -->
            <default>false</default>
        </entry>


        <entry name="focus_timer_start_notification_enabled" type="Bool">
            <default>false</default>
        </entry>

        <entry name="focus_timer_end_notification_enabled" type="Bool">
            <default>true</default>
        </entry>


        <entry name="focus_timer_start_sfx_enabled" type="Bool">
            <default>false</default>
        </entry>

        <entry name="focus_timer_start_sfx_filepath" type="String">
            <default>/usr/share/sounds/ocean/stereo/dialog-information.oga</default>
        </entry>

        <entry name="focus_timer_stop_sfx_enabled" type="Bool">
            <default>true</default>
        </entry>

        <entry name="focus_timer_stop_sfx_filepath" type="String">
            <default>/usr/share/sounds/ocean/stereo/dialog-question.oga</default>
        </entry>

        <entry name="focus_break_start_notification_enabled" type="Bool">
            <default>true</default>
        </entry>

        <entry name="focus_break_start_sfx_enabled" type="Bool">
            <default>false</default>
        </entry>

        <entry name="focus_break_start_sfx_filepath" type="String">
            <default>/usr/share/sounds/ocean/stereo/dialog-information.oga</default>
        </entry>

        <entry name="focus_break_end_notification_enabled" type="Bool">
            <default>true</default>
        </entry>

        <entry name="focus_break_end_sfx_enabled" type="Bool">
            <default>true</default>
        </entry>

        <entry name="focus_break_end_sfx_filepath" type="String">
            <default>/usr/share/sounds/ocean/stereo/dialog-question.oga</default>
        </entry>

        <entry name="focus_break_overrun_repeat_enabled" type="Bool">
            <default>true</default>
        </entry>

        <entry name="focus_break_overrun_repeat_seconds" type="Int">
            <default>60</default>
        </entry>

        <entry name="focus_sound_volume" type="Int">
            <min>0</min>
            <max>100</max>
            <default>100</default>
        </entry>


        <entry name="focus_timer_tick_sfx_enabled" type="Bool">
            <default>false</default>
        </entry>

        <entry name="focus_timer_tick_sfx_filepath" type="String">
            <default>/usr/share/sounds/ocean/stereo/dialog-warning.oga</default>
        </entry>

        <entry name="focus_timer_auto_focus_enabled" type="Bool">
            <default>false</default>
        </entry>

        <entry name="focus_timer_auto_pause_enabled" type="Bool">
            <default>false</default>
        </entry>


        <entry name="focus_start_focus_script_filepath" type="String">
            <default></default>
        </entry>

        <entry name="focus_start_focus_script_enabled" type="Bool">
            <default>false</default>
        </entry>


        <entry name="focus_start_break_script_filepath" type="String">
            <default></default>
        </entry>

        <entry name="focus_start_break_script_enabled" type="Bool">
            <default>false</default>
        </entry>


        <entry name="focus_end_focus_script_filepath" type="String">
            <default></default>
        </entry>

        <entry name="focus_end_focus_script_enabled" type="Bool">
            <default>false</default>
        </entry>


        <entry name="focus_end_break_script_filepath" type="String">
            <default></default>
        </entry>

        <entry name="focus_end_break_script_enabled" type="Bool">
            <default>false</default>
        </entry>


        <entry name="focus_stop_script_filepath" type="String">
            <default></default>
        </entry>

        <entry name="focus_stop_script_enabled" type="Bool">
            <default>false</default>
        </entry>





        <entry name="focus_show_dial_time" type="Bool">
            <default>true</default>
        </entry>

        <entry name="focus_scroll_adjusts_time_enabled" type="Bool">
            <default>true</default>
        </entry>

        <entry name="focus_flash_on_end" type="Bool">
            <default>true</default>
        </entry>

        <entry name="focus_session_state" type="String">
            <default></default>
        </entry>


        <entry name="focus_show_fullscreen_break" type="Bool">
            <default>true</default>
        </entry>

        <entry name="focus_flowmodoro_mode_enabled" type="Bool">
            <default>false</default>
        </entry>

        <!-- During a meeting (Event Calendar) no break starts: a session that runs out holds at its
             end, and the break begins as the meeting ends. (The key's name is from when it paused
             the session instead) -->
        <entry name="focus_meeting_pause" type="Bool">
            <default>true</default>
        </entry>

        <!-- A running focus block pauses while the screen is locked, and resumes on unlock -->
        <entry name="focus_pause_on_lock_enabled" type="Bool">
            <default>true</default>
        </entry>
        <!-- No screen-off, lock or sleep while a session (or its break) runs -->
        <entry name="focus_keep_awake" type="Bool">
            <default>true</default>
        </entry>

        <entry name="focus_autostart" type="Bool">
            <default>false</default>
        </entry>

        <entry name="focus_fullscreen_buttons_postpone" type="Bool">
            <default>true</default>
        </entry>

        <entry name="focus_fullscreen_buttons_skip" type="Bool">
            <default>true</default>
        </entry>

        <entry name="focus_fullscreen_buttons_close" type="Bool">
            <default>true</default>
        </entry>

        <entry name="focus_fullscreen_buttons_end" type="Bool">
            <default>true</default>
        </entry>

        <entry name="focus_do_not_disturb_enabled" type="Bool">
            <default>false</default>
        </entry>

        <entry name="focus_break_pause_media_enabled" type="Bool">
            <default>false</default>
        </entry>

        <entry name="focus_workday_hours" type="Int">
            <min>0</min>
            <max>24</max>
            <!-- Used only to account the day on the Stats page: how much of a working
                 day the timer actually saw. 0 hides that line. -->
            <default>8</default>
        </entry>

        <entry name="focus_min_session_minutes" type="Int">
            <default>5</default>
        </entry>

        <entry name="focus_break_overlay_theme" type="Int">
            <default>0</default>
        </entry>

        <entry name="focus_break_overlay_blur" type="Bool">
            <default>true</default>
        </entry>

        <entry name="focus_break_overlay_opacity" type="Int">
            <default>65</default>
        </entry>

        <entry name="focus_show_buttons_on_hover" type="Bool">
            <default>false</default>
        </entry>

        <entry name="focus_session_history" type="String">
            <default></default>
        </entry>

        <entry name="focus_task_label" type="String">
            <default></default>
        </entry>

        <entry name="focus_task_list" type="String">
            <default></default>
        </entry>
  </group>
</kcfg>
